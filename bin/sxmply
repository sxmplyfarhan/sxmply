#!/usr/bin/env python3
"""Thin entry point for the sxmply tools. All the real code lives in the sxmply/ package."""
import os
import sys

# The launcher may be a symlink, so resolve it to find the repo root
# (the folder that contains sxmply/).
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from sxmply.cli import main  # noqa: E402

if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:  # e.g. `sxmply | head`: stop quietly
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
